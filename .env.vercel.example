# ─────────────────────────────────────────────────────────────────────────────
# Variaveis de ambiente para deploy no Vercel com Firebase Firestore
#
# Como usar:
#   1. Acesse: https://vercel.com/<seu-projeto>/settings/environment-variables
#   2. Copie cada variavel abaixo e configure o valor correspondente.
#   3. Redeploye o projeto.
#
# Nao commite este arquivo com valores reais — use apenas como referencia.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
JWT_SECRET=gere-uma-string-longa-e-aleatoria-aqui
ADMIN_PASSWORD=senha-forte-para-o-painel-admin

# Dominio(s) do frontend no Vercel (sem barra final)
ALLOWED_ORIGINS=https://seuapp.vercel.app

# ── Banco de dados: Firebase Firestore ───────────────────────────────────────
DATABASE_PROVIDER=firebase
FIREBASE_PROJECT_ID=seu-projeto-no-firebase
FIREBASE_DATABASE_ID=(default)

# Credenciais — escolha UMA das opcoes abaixo:
#
# Opcao A: JSON completo da service account (mais simples, uma unica variavel)
# Gere em: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Cole o conteudo do JSON como string (com as aspas internas escapadas ou em uma linha).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opcao B: campos separados da service account
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Armazenamento de fotos: Vercel Blob (opcional) ────────────────────────────
# Crie em: Vercel Dashboard > Storage > Blob > Create Store
# O token e gerado automaticamente ao vincular o store ao projeto.
BLOB_READ_WRITE_TOKEN=

# ── Email de confirmacao: Resend (opcional) ───────────────────────────────────
# Crie uma conta em https://resend.com e gere uma API key.
RESEND_API_KEY=
RESEND_FROM=Festa <festa@seudominio.com>

# ── WhatsApp: Meta Cloud API (opcional) ───────────────────────────────────────
# Configure um app no Meta for Developers e obtenha o token e o phone_id.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
