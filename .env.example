# ─── Obrigatórias ────────────────────────────────────────────────────────────

# String de conexão PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/birthday

# Porta em que o servidor Express vai escutar
PORT=3000

# Segredo para assinar/verificar JWTs (use uma string longa e aleatória)
JWT_SECRET=change-me-use-a-long-random-string

# Senha do painel administrativo
ADMIN_PASSWORD=change-me-use-a-strong-password

# ─── CORS ────────────────────────────────────────────────────────────────────

# Origens permitidas, separadas por vírgula.
# Se não definido, aceita qualquer origem (útil apenas em desenvolvimento local).
# Exemplo: https://meusite.vercel.app,https://www.meusite.com
ALLOWED_ORIGINS=

# ─── Vercel Blob (opcional) ──────────────────────────────────────────────────

# Token para upload de imagens via Vercel Blob
BLOB_READ_WRITE_TOKEN=

# ─── Email — Resend (opcional) ───────────────────────────────────────────────

# Chave de API do Resend para envio de e-mail de confirmação
RESEND_API_KEY=
# Endereço remetente verificado no Resend
RESEND_FROM=Festa <festa@seudominio.com>

# ─── WhatsApp — Meta Cloud API (opcional) ────────────────────────────────────

# Token de acesso do WhatsApp Business
WHATSAPP_TOKEN=
# ID do número de telefone cadastrado na Meta
WHATSAPP_PHONE_ID=
