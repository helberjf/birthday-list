# Runtime
PORT=3000
JWT_SECRET=change-me-use-a-long-random-string
ADMIN_PASSWORD=change-me-use-a-strong-password
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default database for local/VPS Docker
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://birthday:change-me-postgres-password@postgres:5432/birthday

# Firebase Firestore alternative
# Set DATABASE_PROVIDER=firebase and configure one of the credential options below.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIRESTORE_EMULATOR_HOST=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Static frontend served by Express in the VPS container
SERVE_STATIC_FRONTEND=true

# Vercel Blob uploads (optional)
BLOB_READ_WRITE_TOKEN=

# Resend email confirmation (optional)
RESEND_API_KEY=
RESEND_FROM=Festa <festa@seudominio.com>

# WhatsApp Meta Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
