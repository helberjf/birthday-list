{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "artifacts/birthday-invite/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/page"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index"
    },
    {
      "src": "^/admin(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
